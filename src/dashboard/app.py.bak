    var(--bg); color: var(--text); }
section[data-testid="stSidebar"] { background: rgba(9,18,34,0.96); border-right: 1px solid var(--line); }
[data-testid="metric-container"] { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }
.hc-card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 16px; }
